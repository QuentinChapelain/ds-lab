{
  "$description": "Contexte étroit du modificateur largeur (marque.resolver.json) : sous 600 px [H], seuls l'écart de section et les grands textes changent (DS6, DF2). Chaque jeton remplace en entier celui de semantique.tokens.json. Format DTCG 2025.10.",
  "gap": {
    "$type": "dimension",
    "section": {
      "$value": "{space.32}",
      "$description": "Écart entre deux sections de la page, la plus grande respiration verticale ; plus petit en étroit (largeur.etroit.tokens.json)."
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "large": {
        "$value": {
          "fontFamily": "{brand.font.heading}",
          "fontSize": "{font-size.36}",
          "fontWeight": "{font-weight.700}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.3333
        },
        "$description": "Hero d'une page d'accueil ; ligne visée 76 px en large, 48 px en étroit.",
        "$extensions": {
          "ds-lab.hauteur-capitale": "{font.heading.cap-height}"
        }
      },
      "medium": {
        "$value": {
          "fontFamily": "{brand.font.heading}",
          "fontSize": "{font-size.30}",
          "fontWeight": "{font-weight.700}",
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          },
          "lineHeight": 1.3333
        },
        "$description": "Grand chiffre ou bandeau ; ligne visée 60 px en large, 40 px en étroit.",
        "$extensions": {
          "ds-lab.hauteur-capitale": "{font.heading.cap-height}"
        }
      }
    },
    "heading": {
