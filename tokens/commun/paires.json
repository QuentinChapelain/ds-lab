  "forbidden": [
    { "foreground": "text.secondary", "background": "background.component.pressed", "rule": "sur background.component.pressed, le texte passe en text.default" },
    { "foreground": "text.secondary", "background": "background.interactive.strong", "rule": "sur un plein, le texte est text.on-*" },
    { "foreground": "border.strong", "background": "background.component", "rule": "un champ se pose sur background.surface" },
    { "foreground": "border.focus", "background": "background.interactive.strong", "rule": "l’anneau de focus est décalé de 2 px et se pose sur le fond de la page, jamais sur le plein" },
    { "foreground": "text.brand.large", "background": "background.brand.strong", "rule": "sur background.brand.strong, les titres prennent text.on-brand" },
