      "11": {
        "$value": "{color.primary.11}",
        "$description": "pas 11 de l'échelle primary"
      },
      "12": {
        "$value": "{color.primary.12}",
        "$description": "pas 12 de l'échelle primary"
      },
      "$description": "Primaire (actions) : échelle primary, plein soutenu.",
      "$extensions": {
        "ds-lab.plein": {
          "classe": "soutenu",
          "regle": "soutenu (blanc ≥ 4,5 et < 5,5 sur le pas 9) : plein = pas 9, texte blanc ; survol = clarté OKLCH du plein − 0,05 (D45)"
        }
      },
      "solid": {
        "$value": "{color.primary.9}",
        "$description": "plein : pas 9, couleur exacte"
      },
      "solid-hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4824,
            0.2431,
            0.7804
