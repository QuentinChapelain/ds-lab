          "hex": "#7b3ec7"
        },
        "$description": "plein survolé : clarté OKLCH du plein − 0,05, teinte et chroma gardées, valeur calculée (D45)",
        "$extensions": {
          "ds-lab.survol": {
            "base": "{color.primary.9}",
            "clarte": -0.05,
            "espace": "oklch",
            "gamut": "srgb, chroma réduite (CSS Color 4)"
          }
        }
      },
      "on-solid": {
        "$value": "{color.white}",
        "$description": "texte sur le plein : blanc"
