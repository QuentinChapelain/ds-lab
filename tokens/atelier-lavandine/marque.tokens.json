{
  "$description": "Emplacements de marque de Atelier Lavandine, écrits par la saisie depuis entree.json. Format DTCG 2025.10. Les rôles de semantique.tokens.json pointent vers brand.<emplacement>.* ; chaque emplacement pointe vers une échelle (générées dans echelles.tokens.json, communes dans tokens/commun/), et ses pleins suivent la règle en trois cas (sombre, moyen, clair) lue sur le pas 9.",
  "brand": {
    "$type": "color",
    "$description": "Emplacements de marque : primaire et accent (12 pas, plein, plein survolé, texte sur plein), statuts (plein, plein survolé, texte sur plein). Règle des pleins en trois cas, lue sur le pas 9 : sombre, moyen, clair. Survol de tous les pleins : clarté OKLCH du plein − 0,05 (D45). Variante soutenue du cas sombre : blanc entre 4,5 et 5,5 sur le pas 9.",
    "primary": {
      "1": {
        "$value": "{color.primary.1}",
        "$description": "pas 1 de l'échelle primary"
      },
      "2": {
        "$value": "{color.primary.2}",
        "$description": "pas 2 de l'échelle primary"
      },
      "3": {
        "$value": "{color.primary.3}",
        "$description": "pas 3 de l'échelle primary"
      },
