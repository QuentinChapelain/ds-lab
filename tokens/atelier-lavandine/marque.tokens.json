        "$description": "pas 5 de l'échelle primary"
      },
      "6": {
        "$value": "{color.primary.6}",
        "$description": "pas 6 de l'échelle primary"
      },
      "7": {
        "$value": "{color.primary.7}",
        "$description": "pas 7 de l'échelle primary"
