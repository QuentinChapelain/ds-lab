      },
      "12": {
        "$value": "{couleur.bleu.12}",
        "$description": "pas 12 de l'échelle bleu"
      },
      "$description": "Primaire (actions) : échelle bleu, plein sombre.",
      "$extensions": {
        "ds-lab.plein": {
          "classe": "sombre",
          "regle": "sombre (blanc ≥ 5,5 sur le pas 9) : plein = pas 9, texte blanc, survol = plein + voile blanc 8 %"
        }
      },
      "plein": {
        "$value": "{couleur.bleu.9}",
        "$description": "plein : pas 9"
      },
