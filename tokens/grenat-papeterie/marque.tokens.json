      },
      "9": {
        "$value": "{couleur.primaire.9}",
        "$description": "pas 9 de l'échelle primaire"
      },
      "10": {
        "$value": "{couleur.primaire.10}",
        "$description": "pas 10 de l'échelle primaire"
      },
      "11": {
        "$value": "{couleur.primaire.11}",
        "$description": "pas 11 de l'échelle primaire"
      },
      "12": {
        "$value": "{couleur.primaire.12}",
        "$description": "pas 12 de l'échelle primaire"
      },
      "$description": "Primaire (actions) : échelle primaire, plein sombre.",
      "$extensions": {
        "ds-lab.plein": {
          "classe": "sombre",
          "regle": "sombre (blanc ≥ 5,5 sur le pas 9) : plein = pas 9, texte blanc, survol = plein + voile blanc 8 %"
        }
      },
      "plein": {
        "$value": "{couleur.primaire.9}",
        "$description": "plein : pas 9"
      },
      "plein-survol": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5216,
            0.1922,
            0.302
          ],
          "hex": "#85314d"
        },
        "$description": "plein survolé : pas 9 sous un voile blanc de 8 %, valeur calculée",
        "$extensions": {
          "ds-lab.voile": {
            "base": "{couleur.primaire.9}",
            "blanc": 0.08,
            "composition": "blanc posé sur la base, source-over en sRGB"
          }
        }
      },
      "sur-plein": {
        "$value": "{couleur.blanc}",
        "$description": "texte sur le plein : blanc"
      },
      "texte-grand": {
        "$value": "{couleur.primaire.9}",
        "$description": "texte de marque des grands titres (affichage, titres 1 et 2) : pas 9, premier des pas 9, 10, 11 à tenir 3:1 sur fond.app, fond.surface, fond.discret et fond.marque.discret"
