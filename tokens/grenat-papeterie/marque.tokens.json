      },
      "5": {
        "$value": "{couleur.primaire.5}",
        "$description": "pas 5 de l'échelle primaire"
      },
      "6": {
        "$value": "{couleur.primaire.6}",
        "$description": "pas 6 de l'échelle primaire"
      },
      "7": {
        "$value": "{couleur.primaire.7}",
        "$description": "pas 7 de l'échelle primaire"
      },
      "8": {
