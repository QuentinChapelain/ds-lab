      "1": {
        "$value": "{couleur.primaire.1}",
        "$description": "pas 1 de l'échelle primaire"
      },
      "2": {
        "$value": "{couleur.primaire.2}",
        "$description": "pas 2 de l'échelle primaire"
      },
      "3": {
        "$value": "{couleur.primaire.3}",
        "$description": "pas 3 de l'échelle primaire"
      },
      "4": {
        "$value": "{couleur.primaire.4}",
